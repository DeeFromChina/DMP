# DMP (Device Model Protocol) 环境变量配置示例
# 复制此文件为 .env 并填入你的API密钥

# ==================== 服务配置 ====================
SERVICE_NAME=dmp
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=28473

# ==================== 手机厂商LLM配置 ====================

# 华为HMS Core AI
HUAWEI_ENABLED=false
HUAWEI_API_KEY=your_huawei_api_key
HUAWEI_APP_ID=your_huawei_app_id
HUAWEI_PROJECT_ID=your_huawei_project_id
HUAWEI_MODEL=pangu-7b

# 小米AI开放平台
XIAOMI_ENABLED=false
XIAOMI_API_KEY=your_xiaomi_api_key
XIAOMI_SECRET_KEY=your_xiaomi_secret_key
XIAOMI_MODEL=xiaomi-lm

# Apple Core ML (本地模型)
APPLE_ENABLED=false
APPLE_MODEL_PATH=/path/to/apple_model.mlmodel
APPLE_MODEL_NAME=apple-lm

# OPPO AI开放平台
OPPO_ENABLED=false
OPPO_API_KEY=your_oppo_api_key
OPPO_APP_ID=your_oppo_app_id
OPPO_MODEL=oppo-lm

# vivo AI开放平台
VIVO_ENABLED=false
VIVO_API_KEY=your_vivo_api_key
VIVO_APP_ID=your_vivo_app_id
VIVO_MODEL=vivo-lm

# ==================== 云端LLM配置 ====================

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TIMEOUT=30

# Anthropic Claude
CLAUDE_ENABLED=false
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_TIMEOUT=30

# 通义千问
TONGYI_ENABLED=false
TONGYI_API_KEY=your_tongyi_api_key
TONGYI_ENDPOINT=https://dashscope.aliyuncs.com
TONGYI_MODEL=qwen-turbo
TONGYI_TIMEOUT=30

# ==================== 本地LLM配置 ====================
LOCAL_LLM_ENABLED=false
LOCAL_LLM_ENGINE=mlc
LOCAL_LLM_MODEL_PATH=/path/to/local_model
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TEMPERATURE=0.7

# ==================== 回退策略 ====================
FALLBACK_ENABLED=true
MAX_RETRIES=3
RETRY_DELAY=1.0